generator client {
  provider = "prisma-client-js"
  // Isolated client — monorepo root @prisma/client is overwritten by other services
  output   = "../../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id")
  parent    Category? @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")

  attributes Attribute[]
  ads        Ad[]

  @@map("categories")
}

model Ad {
  id          String     @id @default(uuid())
  title       String
  description String?
  price       Decimal    @db.Decimal(12,2)
  currency    String     @default("USD")
  userId      String     @map("user_id")
  categoryId  String     @map("category_id")
  category    Category   @relation(fields: [categoryId], references: [id])

  attributes  AttributeValue[]
  media       Media[]

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  publishedAt DateTime?  @map("published_at")

  @@map("ads")
}

model Attribute {
  id         String     @id @default(uuid())
  categoryId String     @map("category_id")
  name       String
  key        String?
  type       AttributeType
  unit       String?

  category   Category   @relation(fields: [categoryId], references: [id])
  values     AttributeValue[]
  options    AttributeOption[]

  @@unique([categoryId, name], name: "categoryId_name", map: "attributes_category_id_name_key")
  @@map("attributes")
}

enum AttributeType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
  DATE
}

model AttributeOption {
  id          String     @id @default(uuid())
  attributeId String     @map("attribute_id")
  value       String

  attribute   Attribute @relation(fields: [attributeId], references: [id])

  @@unique([attributeId, value], name: "attributeId_value", map: "attribute_options_attribute_id_value_key")
  @@map("attribute_options")
}

model AttributeValue {
  id          String   @id @default(uuid())
  adId        String   @map("ad_id")
  attributeId String   @map("attribute_id")
  value       String   // зберігаємо як текст, конвертуємо на рівні бізнес-логіки

  ad          Ad       @relation(fields: [adId], references: [id])
  attribute   Attribute @relation(fields: [attributeId], references: [id])

  @@map("attribute_values")
}

model Media {
  id        String   @id @default(uuid())
  adId      String   @map("ad_id")
  url       String   // Cloudinary URL
  type      String   // image, video, etc.
  position  Int?

  ad        Ad       @relation(fields: [adId], references: [id])

  @@map("media")
}

model Vehicle {
  id                String                  @id @default(uuid())
  vin               String                  @unique
  year              Int?
  plateNumber       String?                 @map("plate_number")
  brandId           String?                 @map("brand_id")
  modelId           String?                 @map("model_id")
  variantId         String?                 @map("variant_id")
  vehicleType       String?                 @map("vehicle_type")
  color             String?
  engine            String?
  transmission      String?
  fuelType          String?                 @map("fuel_type")
  currentMileageKm  Int?                    @map("current_mileage_km")
  countryCode       String?                 @default("PL") @map("country_code")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  ownerships        VehicleOwnership[]
  photos            VehiclePhoto[]
  saleListings      VehicleSaleListing[]
  maintenance       MaintenanceRecord[]
  serviceVisits     GarageServiceVisit[]
  odometerLogs      OdometerLog[]
  registrationEvents VehicleRegistrationEvent[]
  technicalInspection VehicleTechnicalInspection?
  insurancePolicies   VehicleInsurancePolicy[]
  saleContracts     VehicleSaleContract[]
  reports           VehicleReport[]
  reportAccessGrants VehicleReportAccessGrant[]
  profileViewLogs   VehicleProfileViewLog[]

  @@index([brandId, modelId, variantId], name: "vehicle_brand_model_variant_idx")
  @@map("vehicles")
}

model VehiclePhoto {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  ownerUserId String   @map("owner_user_id")
  url         String
  publicId    String?  @map("public_id")
  createdAt   DateTime @default(now()) @map("created_at")

  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt], name: "vehicle_photo_vehicle_idx")
  @@map("vehicle_photos")
}

enum SaleListingStatus {
  DRAFT
  READY
  ACTIVE
  PAUSED
  SOLD
  ARCHIVED
}

enum DistributionPlatform {
  OUR_SITE
  OTOMOTO
  FACEBOOK_MARKETPLACE
  OLX
  AUTOBAZAR_SK
  AUTORIA
  TIKTOK
  INSTAGRAM
}

enum ListingDistributionStatus {
  PENDING
  IN_PROGRESS
  PUBLISHED
  FAILED
  UNPUBLISHED
}

model VehicleSaleListing {
  id          String                  @id @default(uuid())
  vehicleId   String                  @map("vehicle_id")
  ownerUserId String                  @map("owner_user_id")
  status      SaleListingStatus       @default(DRAFT)
  title       String?
  description String?
  price       Decimal?                @db.Decimal(12,2)
  currency    String?                 @default("PLN")
  marketRegion String?                @map("market_region")
  specsJson   Json?                   @map("specs_json")
  appearanceJson Json?                @map("appearance_json")
  featuresJson Json?                  @map("features_json")
  contactJson Json?                   @map("contact_json")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  vehicle     Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  distributions ListingDistribution[]

  @@index([vehicleId, ownerUserId], name: "sale_listing_vehicle_owner_idx")
  @@map("vehicle_sale_listings")
}

model ListingDistribution {
  id           String                    @id @default(uuid())
  saleListingId String                   @map("sale_listing_id")
  platform     DistributionPlatform
  status       ListingDistributionStatus @default(PENDING)
  externalId   String?                   @map("external_id")
  externalUrl  String?                   @map("external_url")
  lastError    String?                   @map("last_error")
  payloadSnapshot Json?                  @map("payload_snapshot")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  saleListing  VehicleSaleListing        @relation(fields: [saleListingId], references: [id], onDelete: Cascade)

  @@unique([saleListingId, platform], name: "sale_listing_platform_unique", map: "listing_distributions_sale_listing_id_platform_key")
  @@index([saleListingId, status], name: "sale_distribution_status_idx")
  @@map("listing_distributions")
}

enum VehicleProfileTier {
  PUBLIC
  OWNER
  PAID
}

enum VehicleReportStatus {
  PENDING
  READY
  FAILED
  EXPIRED
}

model VehicleReport {
  id         String             @id @default(uuid())
  vehicleId  String             @map("vehicle_id")
  provider   String
  tier       VehicleProfileTier @default(PUBLIC)
  status     VehicleReportStatus @default(PENDING)
  summary    Json?
  rawPayload Json?              @map("raw_payload")
  fetchedAt  DateTime?          @map("fetched_at")
  expiresAt  DateTime?          @map("expires_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  vehicle    Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, provider, tier], name: "vehicle_report_lookup_idx")
  @@map("vehicle_reports")
}

model VehicleReportAccessGrant {
  id          String             @id @default(uuid())
  vehicleId   String             @map("vehicle_id")
  userId      String             @map("user_id")
  provider    String
  accessLevel VehicleProfileTier @default(PAID) @map("access_level")
  source      String             @default("purchase")
  validUntil  DateTime?          @map("valid_until")
  createdAt   DateTime           @default(now()) @map("created_at")

  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, userId, provider], name: "vehicle_report_access_lookup_idx")
  @@map("vehicle_report_access_grants")
}

model VehicleProfileViewLog {
  id            String             @id @default(uuid())
  vehicleId     String             @map("vehicle_id")
  viewerUserId  String?            @map("viewer_user_id")
  requestedTier VehicleProfileTier @default(PUBLIC) @map("requested_tier")
  resolvedTier  VehicleProfileTier @default(PUBLIC) @map("resolved_tier")
  meta          Json?
  createdAt     DateTime           @default(now()) @map("created_at")

  vehicle       Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt], name: "vehicle_profile_view_log_idx")
  @@map("vehicle_profile_view_logs")
}

model OdometerLog {
  id           String   @id @default(uuid())
  vehicleId    String   @map("vehicle_id")
  ownerUserId  String   @map("owner_user_id")
  mileageKm    Int      @map("mileage_km")
  recordedAt   DateTime @default(now()) @map("recorded_at")
  notes        String?
  source       String   @default("manual")

  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt], name: "odometer_vehicle_date_idx")
  @@index([vehicleId, mileageKm], name: "odometer_vehicle_mileage_idx")
  @@map("odometer_logs")
}

model VehicleOwnership {
  id          String    @id @default(uuid())
  vehicleId   String    @map("vehicle_id")
  ownerUserId String    @map("owner_user_id")
  cloudFolder String?   @map("cloud_folder")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  isCurrent   Boolean   @default(true) @map("is_current")
  isPrimary   Boolean   @default(false) @map("is_primary")
  source      String    @default("manual")
  createdAt   DateTime  @default(now()) @map("created_at")

  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, isCurrent], name: "ownership_owner_current_idx")
  @@index([ownerUserId, isPrimary], name: "ownership_owner_primary_idx")
  @@index([vehicleId, isCurrent], name: "ownership_vehicle_current_idx")
  @@map("vehicle_ownerships")
}

enum MaintenanceType {
  ENGINE_OIL
  OIL_FILTER
  AIR_FILTER
  CABIN_FILTER
  SPARK_PLUGS
  CLUTCH_REPLACEMENT
  BRAKE_PADS
  BRAKE_FLUID
  COOLANT
  TIMING_BELT
  TIRE_CHANGE
  OTHER
}

model MaintenanceRecord {
  id           String          @id @default(uuid())
  vehicleId    String          @map("vehicle_id")
  ownerUserId  String          @map("owner_user_id")
  type         MaintenanceType
  title        String
  details      String?
  mileageKm    Int             @map("mileage_km")
  performedAt  DateTime        @map("performed_at")
  costAmount   Decimal?        @db.Decimal(12,2) @map("cost_amount")
  costCurrency String?         @default("PLN") @map("cost_currency")
  source       String          @default("manual")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  attachments  MaintenanceAttachment[]

  @@index([vehicleId, mileageKm], name: "maintenance_vehicle_mileage_idx")
  @@index([vehicleId, performedAt], name: "maintenance_vehicle_date_idx")
  @@map("maintenance_records")
}

model MaintenanceAttachment {
  id                  String            @id @default(uuid())
  maintenanceRecordId String            @map("maintenance_record_id")
  ownerUserId         String            @map("owner_user_id")
  url                 String
  publicId            String?           @map("public_id")
  originalName        String?           @map("original_name")
  mimeType            String?           @map("mime_type")
  sizeBytes           Int?              @map("size_bytes")
  createdAt           DateTime          @default(now()) @map("created_at")

  maintenanceRecord   MaintenanceRecord @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)

  @@index([maintenanceRecordId], name: "maintenance_attachment_record_idx")
  @@map("maintenance_attachments")
}

enum VisitVerifiedBy {
  OWNER
  PARTNER
}

enum PartPurchasedBy {
  OWNER
  WORKSHOP
}

model GarageServiceVisit {
  id               String            @id @default(uuid())
  vehicleId        String            @map("vehicle_id")
  ownerUserId      String            @map("owner_user_id")
  performedAt      DateTime          @map("performed_at")
  odometerKm       Int?              @map("odometer_km")
  totalCost        Decimal?          @map("total_cost") @db.Decimal(12, 2)
  costCurrency     String?           @default("PLN") @map("cost_currency")
  notes            String?
  organizationId   String?           @map("organization_id")
  draftCompanyId   String?           @map("draft_company_id")
  providerSnapshot Json              @map("provider_snapshot")
  verifiedBy       VisitVerifiedBy   @default(OWNER) @map("verified_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  lineItems        GarageServiceLineItem[]
  attachments      GarageServiceVisitAttachment[]

  @@index([vehicleId, performedAt], name: "garage_visit_vehicle_date_idx")
  @@index([ownerUserId], name: "garage_visit_owner_idx")
  @@map("garage_service_visits")
}

model GarageServiceLineItem {
  id          String   @id @default(uuid())
  visitId     String   @map("visit_id")
  sortOrder   Int      @default(0) @map("sort_order")
  name        String
  description String?
  laborCost   Decimal? @map("labor_cost") @db.Decimal(12, 2)
  partsCost   Decimal? @map("parts_cost") @db.Decimal(12, 2)
  lineTotal   Decimal? @map("line_total") @db.Decimal(12, 2)

  visit       GarageServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  parts       GarageServicePart[]

  @@index([visitId, sortOrder], name: "garage_line_item_visit_idx")
  @@map("garage_service_line_items")
}

model GarageServicePart {
  id          String           @id @default(uuid())
  lineItemId  String           @map("line_item_id")
  name        String
  purchasedBy PartPurchasedBy  @map("purchased_by")
  brand       String?
  productUrl  String?          @map("product_url")
  partNumber  String?          @map("part_number")
  cost        Decimal?         @db.Decimal(12, 2)

  lineItem    GarageServiceLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  @@index([lineItemId], name: "garage_part_line_item_idx")
  @@map("garage_service_parts")
}

model GarageServiceVisitAttachment {
  id           String             @id @default(uuid())
  visitId      String             @map("visit_id")
  ownerUserId  String             @map("owner_user_id")
  url          String
  publicId     String?            @map("public_id")
  originalName String?            @map("original_name")
  mimeType     String?            @map("mime_type")
  sizeBytes    Int?               @map("size_bytes")
  createdAt    DateTime           @default(now()) @map("created_at")

  visit        GarageServiceVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId], name: "garage_visit_attachment_visit_idx")
  @@map("garage_service_visit_attachments")
}

enum RegistrationEventType {
  REGISTERED
  DEREGISTERED
  OWNERSHIP_CHANGED
  IMPORTED
  EXPORTED
  OTHER
}

model VehicleRegistrationEvent {
  id          String                @id @default(uuid())
  vehicleId   String                @map("vehicle_id")
  ownerUserId String                @map("owner_user_id")
  eventType   RegistrationEventType @map("event_type")
  eventDate   DateTime              @map("event_date")
  countryCode String?               @map("country_code")
  notes       String?
  createdAt   DateTime              @default(now()) @map("created_at")

  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, eventDate], name: "vehicle_registration_event_idx")
  @@map("vehicle_registration_events")
}

enum InsurancePolicyType {
  OC
  AC
}

model VehicleTechnicalInspection {
  id            String   @id @default(uuid())
  vehicleId     String   @unique @map("vehicle_id")
  ownerUserId   String   @map("owner_user_id")
  performedAt   DateTime @map("performed_at")
  validUntil    DateTime @map("valid_until")
  stationName   String?  @map("station_name")
  certificateNo String?  @map("certificate_no")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([ownerUserId], name: "vehicle_inspection_owner_idx")
  @@map("vehicle_technical_inspections")
}

model VehicleInsurancePolicy {
  id              String              @id @default(uuid())
  vehicleId       String              @map("vehicle_id")
  ownerUserId     String              @map("owner_user_id")
  type            InsurancePolicyType
  insurerName     String              @map("insurer_name")
  policyNumber    String?             @map("policy_number")
  startsAt        DateTime            @map("starts_at")
  endsAt          DateTime            @map("ends_at")
  premiumAmount   Decimal?            @map("premium_amount") @db.Decimal(12, 2)
  premiumCurrency String?             @default("PLN") @map("premium_currency")
  isActive        Boolean             @default(true) @map("is_active")
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, type, isActive], name: "vehicle_insurance_vehicle_type_active_idx")
  @@map("vehicle_insurance_policies")
}

model VehicleSaleContract {
  id                String    @id @default(uuid())
  vehicleId         String    @map("vehicle_id")
  sellerUserId      String    @map("seller_user_id")
  buyerUserId       String?   @map("buyer_user_id")
  sellerSnapshot    Json      @map("seller_snapshot")
  buyerSnapshot     Json      @map("buyer_snapshot")
  salePriceAmount   Decimal?  @db.Decimal(12,2) @map("sale_price_amount")
  salePriceCurrency String?   @default("PLN") @map("sale_price_currency")
  contractDate      DateTime  @map("contract_date")
  generatedText     String    @map("generated_text")
  status            String    @default("draft")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, contractDate], name: "vehicle_sale_contract_idx")
  @@map("vehicle_sale_contracts")
}

// ---------------------------------------------------------------------------
// Local vehicle catalog mirror (CarAPI / CarQuery → DB). Source of truth for community
// generations + variant subgroups. Do not call CarQuery on every user request.
// ---------------------------------------------------------------------------

model CatalogMake {
  id        String         @id
  slug      String         @unique
  name      String
  logoUrl   String?        @map("logo_url")
  syncedAt  DateTime       @default(now()) @map("synced_at")
  models    CatalogModel[]

  @@map("catalog_makes")
}

model CatalogModel {
  id          String              @id
  makeId      String              @map("make_id")
  slug        String
  name        String
  syncedAt    DateTime            @default(now()) @map("synced_at")
  make        CatalogMake         @relation(fields: [makeId], references: [id], onDelete: Cascade)
  generations CatalogGeneration[]

  @@unique([makeId, slug])
  @@map("catalog_models")
}

/// Model line / generation (community GENERATION room), e.g. Tucson 2015–2018.
model CatalogGeneration {
  id               String       @id @default(uuid())
  modelId          String       @map("model_id")
  externalModelId  String?      @map("external_model_id")
  slug             String
  displayName      String       @map("display_name")
  yearFrom         Int?         @map("year_from")
  yearTo           Int?         @map("year_to")
  coverImageUrl    String?      @map("cover_image_url")
  shortDescription String?      @map("short_description")
  isSupported      Boolean      @default(true) @map("is_supported")
  supportTier      String       @default("active") @map("support_tier")
  contentKey       String?      @unique @map("content_key")
  /// approved | draft | rejected — same gate as catalog_engine_families/catalog_engines.
  /// Defaults to "approved" so existing/synced rows keep showing publicly unchanged.
  reviewStatus     String       @default("approved") @map("review_status")
  reviewedAt       DateTime?    @map("reviewed_at")
  syncedAt         DateTime     @default(now()) @map("synced_at")
  model            CatalogModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  trims            CatalogTrim[]

  @@unique([modelId, slug])
  @@index([externalModelId])
  @@map("catalog_generations")
}

/// Engine subgroup (community VARIANT), e.g. 2.0 CRDi 185 KM — not trim package (Premium).
/// Derived from the raw fuelType/aspiration strings by scripts/backfill-canonical-fuel-type.ts
/// (AUT-33) — never written directly by catalog:sync:autoria. The raw String columns stay
/// permissive on purpose (see that ticket): AUTO.RIA's raw vocabulary isn't fully controlled
/// (abbreviations, language variants — see formatFuelLabel() in engine-trim.utils.ts), so a
/// hard enum on the sync-target column would break ingestion on any unrecognized raw value.
enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  UNKNOWN
}

/// Same rationale as FuelType above — derived only, raw `aspiration` column stays String.
enum Aspiration {
  TURBO
  ATMO
  SUPERCHARGED
  UNKNOWN
}

model CatalogTrim {
  id                   String                     @id
  generationId         String                     @map("generation_id")
  slug                 String
  displayName          String                     @map("display_name")
  modelYear            Int?                       @map("model_year")
  engine               String?
  fuelType             String?                    @map("fuel_type")
  /// Derived canonical value — see FuelType enum doc comment. Null until backfilled.
  canonicalFuelType    FuelType?                  @map("canonical_fuel_type")
  aspiration           String?
  powerHp              Int?                       @map("power_hp")
  transmission         String?
  engineCode           String?                    @map("engine_code")
  displacementCc       Int?                       @map("displacement_cc")
  contentKey           String?                    @unique @map("content_key")
  engineId             String?                    @map("engine_id")
  transmissionId       String?                    @map("transmission_id")
  engineFamilyId       String?                    @map("engine_family_id")
  transmissionFamilyId String?                    @map("transmission_family_id")
  /// approved | draft | rejected — same gate as catalog_engines/catalog_transmissions.
  /// Defaults to "approved" so existing/synced rows keep showing publicly unchanged.
  reviewStatus         String                     @default("approved") @map("review_status")
  reviewedAt           DateTime?                  @map("reviewed_at")
  syncedAt             DateTime                   @default(now()) @map("synced_at")
  generation           CatalogGeneration          @relation(fields: [generationId], references: [id], onDelete: Cascade)
  engineUnit           CatalogEngine?             @relation(fields: [engineId], references: [id], onDelete: SetNull)
  transmissionUnit     CatalogTransmission?       @relation(fields: [transmissionId], references: [id], onDelete: SetNull)
  engineFamily         CatalogEngineFamily?       @relation(fields: [engineFamilyId], references: [id], onDelete: SetNull)
  transmissionFamily   CatalogTransmissionFamily? @relation(fields: [transmissionFamilyId], references: [id], onDelete: SetNull)

  @@unique([generationId, slug])
  @@index([engineId])
  @@index([transmissionId])
  @@index([engineFamilyId])
  @@index([transmissionFamilyId])
  @@map("catalog_trims")
}

/// ETL audit log (docs/V1_7_VEHICLE_ENCYCLOPEDIA.md §13.2) — one row per script run.
model CatalogSyncRun {
  id            String    @id @default(uuid())
  script        String    // catalog:sync:autoria | catalog:link:engines | ...
  status        String    // running | success | failed | partial
  scopeMakeSlug String?   @map("scope_make_slug")
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  stats         Json?
  errorMessage  String?   @map("error_message")

  @@index([script, startedAt])
  @@map("catalog_sync_runs")
}

/// Curated engine family KB (Phase C) — linked from trims, shared across models.
model CatalogEngineFamily {
  id               String        @id @default(uuid())
  slug             String        @unique
  displayName      String        @map("display_name")
  manufacturer     String?
  displacementCc   Int?          @map("displacement_cc")
  fuelType         String?       @map("fuel_type")
  /// Derived canonical value — see FuelType enum doc comment. Null until backfilled.
  canonicalFuelType FuelType?    @map("canonical_fuel_type")
  aspiration       String?
  /// Derived canonical value — see Aspiration enum doc comment. Null until backfilled.
  canonicalAspiration Aspiration? @map("canonical_aspiration")
  engineCodes      String[]      @default([]) @map("engine_codes")
  specsJson        Json?         @map("specs_json")
  shortDescription String?       @map("short_description")
  reviewStatus     String        @default("approved") @map("review_status")
  reviewedAt       DateTime?     @map("reviewed_at")
  source           String?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  trims            CatalogTrim[]
  engines          CatalogEngine[]

  @@map("catalog_engine_families")
}

/// Concrete engine unit inside a family — one row per code + power variant (D4FD 116 KM).
model CatalogEngine {
  id               String               @id @default(uuid())
  familyId         String               @map("family_id")
  slug             String               @unique
  code             String?
  displayName      String               @map("display_name")
  displacementCc   Int?                 @map("displacement_cc")
  fuelType         String?              @map("fuel_type")
  /// Derived canonical value — see FuelType enum doc comment. Null until backfilled.
  canonicalFuelType FuelType?           @map("canonical_fuel_type")
  aspiration       String?
  powerHp          Int?                 @map("power_hp")
  powerKw          Int?                 @map("power_kw")
  torqueNm         Int?                 @map("torque_nm")
  cylinders        Int?
  injection        String?
  euroStandard     String?              @map("euro_standard")
  yearFrom         Int?                 @map("year_from")
  yearTo           Int?                 @map("year_to")
  specsJson        Json?                @map("specs_json")
  shortDescription String?              @map("short_description")
  reliabilityNotes String?              @map("reliability_notes")
  reviewStatus     String               @default("approved") @map("review_status")
  reviewedAt       DateTime?            @map("reviewed_at")
  source           String?
  externalRef      String?              @map("external_ref")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  family           CatalogEngineFamily  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  trims            CatalogTrim[]

  @@index([familyId])
  @@index([code])
  @@map("catalog_engines")
}

/// Curated transmission family KB (Phase C).
model CatalogTransmissionFamily {
  id               String        @id @default(uuid())
  slug             String        @unique
  displayName      String        @map("display_name")
  type             String?
  gears            Int?
  manufacturer     String?
  specsJson        Json?         @map("specs_json")
  shortDescription String?       @map("short_description")
  reviewStatus     String        @default("approved") @map("review_status")
  reviewedAt       DateTime?     @map("reviewed_at")
  source           String?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  trims            CatalogTrim[]
  transmissions    CatalogTransmission[]

  @@map("catalog_transmission_families")
}

/// Concrete gearbox unit inside a family — one row per code (D7UF1, M6CF1, A6MF1).
model CatalogTransmission {
  id               String                    @id @default(uuid())
  familyId         String                    @map("family_id")
  slug             String                    @unique
  code             String?
  displayName      String                    @map("display_name")
  type             String?
  gears            Int?
  drive            String?
  maxTorqueNm      Int?                      @map("max_torque_nm")
  yearFrom         Int?                      @map("year_from")
  yearTo           Int?                      @map("year_to")
  specsJson        Json?                     @map("specs_json")
  shortDescription String?                   @map("short_description")
  reliabilityNotes String?                   @map("reliability_notes")
  reviewStatus     String                    @default("approved") @map("review_status")
  reviewedAt       DateTime?                 @map("reviewed_at")
  source           String?
  externalRef      String?                   @map("external_ref")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  family           CatalogTransmissionFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  trims            CatalogTrim[]

  @@index([familyId])
  @@index([code])
  @@map("catalog_transmissions")
}
