# AUT-32 — OCR vehicle-import adapter (docs/V1_5_VEHICLE_AUTOADD_OCR_RESEARCH.md).
# Google Cloud Document AI. Optional: without these, the "ocr" import method
# returns { status: 'FAILED', error: 'OCR is not configured.' } and the
# existing "mock" method keeps working unaffected.
#
# Auth itself is via the standard GOOGLE_APPLICATION_CREDENTIALS env var
# (path to a service-account JSON key), read automatically by the underlying
# google-auth-library — not one of these three.
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_PROCESSOR_ID=
# Defaults to 'eu' if unset — keep it EU for RODO (europe-west2/europe-west3
# are the other genuine EU-region options; see the research doc §3).
DOCUMENT_AI_LOCATION=eu
